    </record>

    <record id="event_despues" model="tourism.event">
        <field name="name">Ruta del vino en la Ribera del Duero</field>
        <field name="start_date">2026-10-09 08:00:00</field>
        <field name="state">despues</field>
        <field name="location">Aranda de Duero, Burgos</field>
        <field name="capacity">40</field>
        <field name="description">Ruta de bodegas con cata y comida tradicional. Finalizada.</field>
    </record>

    <record id="event_durante" model="tourism.event">
        <field name="name">Escapada cultural a Toledo</field>
        <field name="start_date">2026-10-26 08:00:00</field>
        <field name="state">durante</field>
        <field name="location">Toledo</field>
        <field name="capacity">25</field>
        <field name="description">Visita guiada por el casco histórico y la catedral. En curso.</field>
    </record>

    <record id="event_antes" model="tourism.event">
        <field name="name">Senderismo en la Sierra de Gredos</field>
        <field name="start_date">2026-11-20 09:00:00</field>
        <field name="state">antes</field>
        <field name="location">Candeleda, Ávila</field>
        <field name="capacity">30</field>
        <field name="description">Dos jornadas de senderismo por la Garganta de Alardos. Pendiente de celebrar.</field>
    </record>

    <record id="seed_alloc_despues_guide" model="tourism.allocation">
        <field name="event_id" ref="event_despues"/>
        <field name="resource_id" ref="seed_resource_guide_lucia"/>
        <field name="date_start">2026-10-09 08:00:00</field>
        <field name="date_end">2026-10-11 20:00:00</field>
        <field name="status">released</field>
    </record>

