<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Initial data (not demo). Loaded in order: resources, events, allocations;
         allocations go through tourism.allocation.create, so overlaps are rejected. -->

    <record id="seed_resource_guide_lucia" model="tourism.resource">
        <field name="name">Lucía Fernández</field>
        <field name="kind">guide</field>
    </record>

    <record id="seed_resource_guide_carlos" model="tourism.resource">
